<div class="tree-grid-pagination">
    <div class="pagination-info">
        @if (TotalItems > 0)
        {
            <span>Showing @StartItem-@EndItem of @TotalItems packages</span>
        }
        else
        {
            <span>No packages</span>
        }
    </div>

    <div class="pagination-controls">
        <select class="page-size-select" value="@PageSize" @onchange="OnPageSizeChange">
            <option value="20">20</option>
            <option value="40">40</option>
            <option value="100">100</option>
        </select>

        <button class="pagination-btn" disabled="@(!HasPrevious)" @onclick="GoToPrevious">
            ‹ Prev
        </button>

        @foreach (var page in GetVisiblePages())
        {
            @if (page == -1)
            {
                <span class="pagination-ellipsis">...</span>
            }
            else
            {
                <button class="pagination-btn @(page == CurrentPage ? "active" : "")"
                        @onclick="() => GoToPage(page)">
                    @(page)
                </button>
            }
        }

        <button class="pagination-btn" disabled="@(!HasNext)" @onclick="GoToNext">
            Next ›
        </button>
    </div>
</div>

<style>
    .tree-grid-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-top: 1px solid #eee;
        background: #fafafa;
    }

    .pagination-info {
        color: #666;
        font-size: 14px;
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .page-size-select {
        padding: 6px 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        background: white;
        cursor: pointer;
    }

    .page-size-select:focus {
        outline: none;
        border-color: #0078d4;
    }

    .pagination-btn {
        padding: 6px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        background: white;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .pagination-btn:hover:not(:disabled) {
        background: #f5f5f5;
        border-color: #ccc;
    }

    .pagination-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .pagination-btn.active {
        background: #0078d4;
        border-color: #0078d4;
        color: white;
    }

    .pagination-ellipsis {
        padding: 0 4px;
        color: #999;
    }

    @@media (max-width: 768px) {
        .tree-grid-pagination {
            flex-direction: column;
            gap: 10px;
        }

        .pagination-info {
            order: 2;
        }

        .pagination-controls {
            order: 1;
            flex-wrap: wrap;
            justify-content: center;
        }
    }
</style>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int PageSize { get; set; } = 40;
    [Parameter] public int TotalItems { get; set; }

    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }

    /// <summary>First item number on current page (1-indexed).</summary>
    private int StartItem => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;

    /// <summary>Last item number on current page.</summary>
    private int EndItem => Math.Min(CurrentPage * PageSize, TotalItems);

    private bool HasPrevious => CurrentPage > 1;
    private bool HasNext => CurrentPage < TotalPages;

    /// <summary>
    /// Returns list of page numbers to display, with -1 representing ellipsis.
    /// Shows: first, last, current, and 1-2 pages around current.
    /// Example: [1, -1, 4, 5, 6, -1, 20]
    /// </summary>
    private IEnumerable<int> GetVisiblePages()
    {
        if (TotalPages <= 7)
        {
            // Show all pages if 7 or fewer
            for (int i = 1; i <= TotalPages; i++)
                yield return i;
            yield break;
        }

        // Always show first page
        yield return 1;

        // Calculate range around current page
        int rangeStart = Math.Max(2, CurrentPage - 1);
        int rangeEnd = Math.Min(TotalPages - 1, CurrentPage + 1);

        // Adjust range to always show 3 pages in the middle
        if (rangeStart <= 3)
        {
            rangeStart = 2;
            rangeEnd = Math.Min(4, TotalPages - 1);
        }
        else if (rangeEnd >= TotalPages - 2)
        {
            rangeEnd = TotalPages - 1;
            rangeStart = Math.Max(2, TotalPages - 3);
        }

        // Ellipsis before range
        if (rangeStart > 2)
            yield return -1;

        // Pages in range
        for (int i = rangeStart; i <= rangeEnd; i++)
            yield return i;

        // Ellipsis after range
        if (rangeEnd < TotalPages - 1)
            yield return -1;

        // Always show last page
        if (TotalPages > 1)
            yield return TotalPages;
    }

    private async Task GoToPage(int page)
    {
        if (page != CurrentPage && page >= 1 && page <= TotalPages)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }

    private async Task GoToPrevious()
    {
        if (HasPrevious)
        {
            await OnPageChanged.InvokeAsync(CurrentPage - 1);
        }
    }

    private async Task GoToNext()
    {
        if (HasNext)
        {
            await OnPageChanged.InvokeAsync(CurrentPage + 1);
        }
    }

    private async Task OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize))
        {
            await OnPageSizeChanged.InvokeAsync(newSize);
        }
    }
}
