@code {
    private string _serverUrl = "";
    private bool _showPackageSpecific;
    private string _selectedPackageId = "";
    private List<PackageInfo> _packages = [];

    protected override async Task OnInitializedAsync()
    {
        _serverUrl = Navigation.BaseUri.TrimEnd('/');

        _packages = await Db.Packages
            .OrderBy(p => p.DisplayName)
            .Select(p => new PackageInfo { PackageId = p.PackageId, DisplayName = p.DisplayName })
            .ToListAsync();

        if (_packages.Count > 0)
        {
            _selectedPackageId = _packages[0].PackageId;
        }
    }

    private string GetGitHubActionsSnippet()
    {
        var packageId = _showPackageSpecific && !string.IsNullOrEmpty(_selectedPackageId)
            ? _selectedPackageId
            : "<PACKAGE_ID>";

        return $@"name: Release
on:
  push:
    tags: ['v*']

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Install Instella CLI
        run: |
          dotnet tool install --global instella-cli
          echo ""$HOME/.dotnet/tools"" >> ""$GITHUB_PATH""

      - name: Publish
        run: dotnet publish -c Release -r linux-x64 -o ./publish

      - name: Upload to Instella
        env:
          INSTELLA_API_KEY: ${{{{ secrets.INSTELLA_API_KEY }}}}
          INSTELLA_SIGNING_KEY_PASSWORD: ${{{{ secrets.INSTELLA_SIGNING_KEY_PASSWORD }}}}
        run: |
          instella upload \
            --server ${{{{ secrets.INSTELLA_SERVER }}}} \
            --package {packageId} \
            --version ""${{GITHUB_REF_NAME#v}}"" \
            --os linux \
            --arch x64 \
            --path ./publish \
            --channel stable \
            --signing-key ""${{{{ secrets.INSTELLA_SIGNING_KEY }}}}""";
    }

    private string GetGiteaActionsSnippet()
    {
        var packageId = _showPackageSpecific && !string.IsNullOrEmpty(_selectedPackageId)
            ? _selectedPackageId
            : "<PACKAGE_ID>";

        return $@"name: Release
on:
  push:
    tags: ['v*']

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Install Instella CLI
        run: |
          dotnet tool install --global instella-cli
          echo ""$HOME/.dotnet/tools"" >> ""$GITHUB_PATH""

      - name: Publish
        run: dotnet publish -c Release -r linux-x64 -o ./publish

      - name: Upload to Instella
        env:
          INSTELLA_API_KEY: ${{{{ secrets.INSTELLA_API_KEY }}}}
          INSTELLA_SIGNING_KEY_PASSWORD: ${{{{ secrets.INSTELLA_SIGNING_KEY_PASSWORD }}}}
        run: |
          instella upload \
            --server ${{{{ secrets.INSTELLA_SERVER }}}} \
            --package {packageId} \
            --version ""${{GITHUB_REF_NAME#v}}"" \
            --os linux \
            --arch x64 \
            --path ./publish \
            --channel stable \
            --signing-key ""${{{{ secrets.INSTELLA_SIGNING_KEY }}}}""";
    }

    private Task CopyToClipboard(string text)
    {
        // Note: Clipboard API requires JavaScript interop
        // This is a placeholder - in a real implementation you'd use JSRuntime
        return Task.CompletedTask;
    }

    private class PackageInfo
    {
        public string PackageId { get; set; } = "";
        public string DisplayName { get; set; } = "";
    }
}
