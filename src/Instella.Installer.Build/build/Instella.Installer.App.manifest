<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    Shared application manifest bundled with Instella.Installer.Build.
    Imported into the user's *.Installer project by Instella.Installer.Build.props
    unless the user sets their own <ApplicationManifest>.

    Declares:
      - Dependency on Microsoft.Windows.Common-Controls v6 → themed buttons,
        progress bars, combo boxes, etc. Without this, Win32 controls fall
        back to their unthemed Windows 98/2000 look.
      - Per-monitor DPI awareness v2 → matches the programmatic
        Win32DpiAware.EnsureProcessDpiAwareness() call in the widget host
        and ensures layout runs at the right DPI from the moment the
        window is created.
      - Windows 10/11 compatibility GUIDs → lets GetVersion / version-
        conditional API return the real OS version instead of the 6.2
        compatibility shim.
      - requestedExecutionLevel asInvoker → the installer starts unelevated and
        relaunches itself through UAC ("runas") only when a machine-wide
        operation needs it. requireAdministrator would force a UAC prompt on
        per-user installs, defeating per-user scope. Declaring asInvoker
        explicitly also switches off Windows' installer-detection heuristic,
        which would otherwise elevate any exe named *setup* / *install*.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="Instella.Installer"/>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"/>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 + Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
</assembly>
