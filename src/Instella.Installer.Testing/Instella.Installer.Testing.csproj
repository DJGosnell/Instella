<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Instella.Installer.Testing</RootNamespace>
    <AssemblyName>Instella.Installer.Testing</AssemblyName>
    <Description>Test harness for Instella installers: in-memory filesystem and registry, and fake platform services, so installer logic can be exercised in CI without touching the machine. Windows x64/arm64/x86 supported; Linux and macOS experimental.</Description>
    <PackageId>Instella.Installer.Testing</PackageId>
    <PackageTags>instella;installer;testing;test-harness;fakes</PackageTags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Instella.Core\Instella.Core.csproj" />
    <ProjectReference Include="..\Instella.Installer.Runtime\Instella.Installer.Runtime.csproj" />
  </ItemGroup>
</Project>
