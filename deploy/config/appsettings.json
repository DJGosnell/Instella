{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Data Source=/config/instella.db"
  },
  "Storage": {
    "Local": {
      "BasePath": "/packages"
    }
  },
  "Diff": {
    "Enabled": true,
    "MaxPatchRatio": 0.9
  }
}
